{
  "appId": "com.benjasoa.francaispourtous",
  "appName": "Français pour Tous Pro",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "../keystores/release-key.jks",
      "keystorePassword": "${KEYSTORE_PASSWORD}",
      "keystoreAlias": "release",
      "keystoreAliasPassword": "${KEYSTORE_ALIAS_PASSWORD}",
      "releaseType": "AAB"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#1976d2",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#ffffff"
    },
    "LocalNotifications": {},
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Geolocation": {},
    "Storage": {}
  }
}
