{
  "name": "francais-pour-tous-pro-2026",
  "version": "1.0.0",
  "description": "Professional French Learning Application for Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "android": "capacitor build android",
    "android:run": "capacitor run android",
    "android:release": "capacitor build android --prod",
    "sync": "capacitor sync android",
    "open:android": "capacitor open android",
    "firebase:init": "firebase init",
    "firebase:deploy": "firebase deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
