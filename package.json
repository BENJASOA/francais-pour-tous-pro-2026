    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "firebase": "^10.7.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/storage": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "axios": "^1.6.0",
    "dexie": "^3.2.0",
    "localforage": "^1.10.0",
    "zustand": "^4.4.0",
